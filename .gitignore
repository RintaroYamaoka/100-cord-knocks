# Rust
/target
**/*.rs.bk

# Trunk output
/dist

# エディタバンドルのビルド依存 (package.json / package-lock.json はコミットする)
/node_modules

# Vercel
.vercel
# vercel env pull が置く開発用 OIDC トークン (12 時間で失効するがコミットしない)
.env*.local

# project-bootstrap ephemeral markers (commit しない)
.bootstrap/lane
docs/bootstrap/sprint/.gate

# OS/editor
.DS_Store

# 並列 lane の隔離 worktree (ephemeral)
.claude/worktrees/

# 問題生成の中間成果物 (統合後は <難易度>.json が正本)
# trunk が data/ を丸ごと dist へコピーするので、置きっぱなしだと本番に載る
data/problems/*/_batches/
.env*
